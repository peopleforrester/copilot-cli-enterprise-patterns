#!/usr/bin/env bash
# ABOUTME: Local stand-in for CI's global markdownlint install, run through npx at the CI pin.
# ABOUTME: tests/run.sh puts this directory on PATH so the lint hook and repo lint both use it.

set -euo pipefail

# Must match the `npm install -g markdownlint-cli@...` pin in .github/workflows/ci.yml;
# tests/run.sh fails if the two drift apart.
readonly MARKDOWNLINT_CLI_VERSION="0.49.1"

if ! command -v npx >/dev/null 2>&1; then
    printf 'FAIL: npx not on PATH; markdownlint-cli@%s needs Node.js\n' \
        "${MARKDOWNLINT_CLI_VERSION}" >&2
    exit 1
fi

exec npx --yes --package="markdownlint-cli@${MARKDOWNLINT_CLI_VERSION}" -- markdownlint "$@"
