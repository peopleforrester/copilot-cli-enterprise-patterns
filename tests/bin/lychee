#!/usr/bin/env bash
# ABOUTME: Local stand-in for a lychee install: fetches the pinned release binary, checks its hash.
# ABOUTME: tests/e2e.sh puts this directory on PATH; the binary is cached outside the repo.

set -euo pipefail

readonly LYCHEE_VERSION="0.24.2"
readonly RELEASE_URL="https://github.com/lycheeverse/lychee/releases/download/lychee-v${LYCHEE_VERSION}"

# Digests published with the lychee-v0.24.2 release. A mismatch means a tampered or
# truncated download, so it is a failure, never a retry with the check skipped.
case "$(uname -s)-$(uname -m)" in
    Linux-x86_64)
        asset="lychee-x86_64-unknown-linux-musl.tar.gz"
        sha256="73657a111819a30c47c08352896796f23d64e4eb2b3ed39b6d32149241566fc5"
        ;;
    Linux-aarch64)
        asset="lychee-aarch64-unknown-linux-musl.tar.gz"
        sha256="5d0b0e3aeab240f41920c633a6eaf97599be6eedda034b36e858ede7dba5e535"
        ;;
    *)
        printf 'FAIL: no pinned lychee %s build for %s; install lychee 0.24+ on PATH\n' \
            "${LYCHEE_VERSION}" "$(uname -s)-$(uname -m)" >&2
        exit 1
        ;;
esac

cache_dir="${XDG_CACHE_HOME:-${HOME}/.cache}/copilot-cli-enterprise-patterns/lychee-${LYCHEE_VERSION}"
binary="${cache_dir}/lychee"

if [[ ! -x "${binary}" ]]; then
    for tool in curl sha256sum tar; do
        if ! command -v "${tool}" >/dev/null 2>&1; then
            printf 'FAIL: %s not on PATH; fetching lychee %s needs it\n' \
                "${tool}" "${LYCHEE_VERSION}" >&2
            exit 1
        fi
    done
    mkdir -p "${cache_dir}"
    staging="$(mktemp -d "${cache_dir}/fetch.XXXXXX")"
    trap 'rm -rf "${staging}"' EXIT
    if ! curl -fsSL --retry 2 -o "${staging}/${asset}" "${RELEASE_URL}/${asset}"; then
        printf 'FAIL: could not download %s/%s\n' "${RELEASE_URL}" "${asset}" >&2
        exit 1
    fi
    if ! printf '%s  %s\n' "${sha256}" "${staging}/${asset}" | sha256sum --check --status; then
        printf 'FAIL: sha256 mismatch for %s (expected %s)\n' "${asset}" "${sha256}" >&2
        exit 1
    fi
    # The release tarball wraps everything in a directory named after the asset.
    member="${asset%.tar.gz}/lychee"
    tar -xzf "${staging}/${asset}" -C "${staging}" "${member}"
    # Rename into place so a half-written binary is never mistaken for a cached one.
    mv "${staging}/${member}" "${binary}"
    # exec below replaces this shell, so the EXIT trap would never fire on success.
    rm -rf "${staging}"
    trap - EXIT
fi

exec "${binary}" "$@"
